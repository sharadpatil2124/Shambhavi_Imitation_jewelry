# Storefront on Hostinger (Apache / LiteSpeed). Copied into dist/ by "npm run build";
# the build replaces __API_ORIGIN__ with the backend address from VITE_API_URL.

# ---- SPA fallback ----
# Any request that is not a real file or folder is served index.html,
# so React Router can handle routes like /shop or /product/... on refresh.

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve index.html itself directly
  RewriteRule ^index\.html$ - [L]

  # Missing build assets should return a real 404, not index.html
  RewriteCond %{REQUEST_URI} !^/assets/

  # Real files and folders are served as-is
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Everything else goes to the React app
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Always revalidate index.html so new deployments are picked up immediately.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # ---- Security headers ----
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), magnetometer=(), gyroscope=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # Report-only: browsers report violations in the console but block nothing.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' __API_ORIGIN__ https://*.razorpay.com; frame-src https://*.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
