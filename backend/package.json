{
  "name": "shambhavi-imitation-backend",
  "version": "1.0.0",
  "description": "Production-ready backend (Express + MySQL) for Shambhavi Imitation luxury jewelry eCommerce",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test __tests__/*.test.js",
    "db:setup": "node scripts/setupDatabase.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrate.js --status",
    "seed:admin": "node seeder/createAdmin.js",
    "seed:catalog": "node seeder/seedCatalog.js"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "razorpay": "^2.9.2",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "keywords": [
    "express",
    "ecommerce",
    "jewelry",
    "backend",
    "mysql",
    "razorpay"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
