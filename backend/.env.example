# Copy this file to .env and fill in the values. Never commit .env (it holds passwords).

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# ---- MySQL database ----
# Either separate values:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=shambhavi_jewelry
# ...or one connection URL instead (special characters in the password must be URL-encoded):
# MYSQL_URL=mysql://user:password@host:3306/shambhavi_jewelry
# Optional:
# MYSQL_SSL=true              encrypted connection, if your database provider requires it
# MYSQL_SSL_CA=/path/ca.pem   provider's certificate file, if they give you one
# MYSQL_POOL_SIZE=10          simultaneous database connections

# ---- Images ----
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email (Brevo) ----
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_EMAIL_FROM=
BREVO_EMAIL_FROM_NAME=Shambhavi Imitation

# ---- Security ----
# ALLOWED_ORIGINS=https://your-store.example,https://your-admin.example
# TRUST_PROXY_HOPS=1
